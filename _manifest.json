{
  "manifest_version": 2,
  "version": "1.4.1",
  "name": "自我信息插件 (Self Identity)",
  "description": "为 Bot 提供自我信息检索、人设图库浏览、自我图片与 QQ 头像获取能力",
  "author": {
    "name": "ValleyWinds",
    "url": "https://github.com/ValleyWinds"
  },
  "license": "GPL-3.0-or-later",
  "plugin_type": "chat",
  "urls": {
    "repository": "https://github.com/ValleyWinds/Self-Identity",
    "homepage": "https://github.com/ValleyWinds/Self-Identity",
    "documentation": "https://github.com/ValleyWinds/Self-Identity/blob/main/README.md",
    "issues": "https://github.com/ValleyWinds/Self-Identity/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "999.999.999"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "config.get"
  ],
  "display": {
    "icon": {
      "type": "emoji",
      "value": "🪞",
      "background": "#E8F0F7"
    }
  },
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "valleywinds.self-identity"
}
